{
  "version": 8,
  "name": "Moonlight (minimal dark)",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "omt": { "type": "vector", "url": "https://tiles.openfreemap.org/planet", "attribution": "© OpenMapTiles © OpenStreetMap contributors · tiles by OpenFreeMap" }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#121a2a" } },
    { "id": "landuse-built", "type": "fill", "source": "omt", "source-layer": "landuse", "filter": ["in", "class", "residential", "suburb", "neighbourhood", "commercial", "industrial"], "minzoom": 7,
      "paint": { "fill-color": "#1a2436", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0.4, 11, 0.8] } },
    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water", "filter": ["!=", "brunnel", "tunnel"], "paint": { "fill-color": "#0a111d" } },
    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway", "minzoom": 5, "filter": ["in", "class", "river", "canal"],
      "paint": { "line-color": "#0a111d", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 10, 2.4] } },
    { "id": "road-minor", "type": "line", "source": "omt", "source-layer": "transportation", "minzoom": 9, "filter": ["in", "class", "minor", "service", "tertiary"],
      "paint": { "line-color": "#223047", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.4, 13, 2] } },
    { "id": "road-secondary", "type": "line", "source": "omt", "source-layer": "transportation", "minzoom": 7, "filter": ["in", "class", "secondary", "primary", "trunk"],
      "paint": { "line-color": "#2c3d5a", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 12, 2.4] } },
    { "id": "road-motorway-glow", "type": "line", "source": "omt", "source-layer": "transportation", "minzoom": 4, "filter": ["==", "class", "motorway"],
      "paint": { "line-color": "#4a6fa5", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 2, 8, 5, 12, 10], "line-opacity": 0.18, "line-blur": 3 } },
    { "id": "road-motorway", "type": "line", "source": "omt", "source-layer": "transportation", "minzoom": 4, "filter": ["==", "class", "motorway"],
      "paint": { "line-color": "#51719f", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.5, 8, 1.4, 12, 3] } },
    { "id": "boundary-state", "type": "line", "source": "omt", "source-layer": "boundary", "minzoom": 5, "filter": ["all", ["==", "admin_level", 4], ["!=", "maritime", 1]],
      "paint": { "line-color": "#34435c", "line-width": 0.7, "line-dasharray": [2, 3] } },
    { "id": "boundary-country", "type": "line", "source": "omt", "source-layer": "boundary", "filter": ["all", ["==", "admin_level", 2], ["!=", "maritime", 1]],
      "paint": { "line-color": "#6d7f9e", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.7, 8, 1.4], "line-opacity": 0.8 } },
    { "id": "water-name", "type": "symbol", "source": "omt", "source-layer": "water_name", "minzoom": 4, "filter": ["in", "class", "sea", "ocean", "lake"],
      "layout": { "text-field": ["get", "name:en"], "text-font": ["Noto Sans Italic"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 8, 14], "text-letter-spacing": 0.25, "symbol-placement": "point", "text-max-width": 6 },
      "paint": { "text-color": "#3d5273", "text-halo-color": "#0a111d", "text-halo-width": 1 } },
    { "id": "place-city", "type": "symbol", "source": "omt", "source-layer": "place", "minzoom": 4, "filter": ["in", "class", "city"],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 8, 13, 11, 17], "text-anchor": "top", "text-offset": [0, 0.3], "text-max-width": 8 },
      "paint": { "text-color": "#c8d3e6", "text-halo-color": "#121a2a", "text-halo-width": 1.4 } },
    { "id": "place-town", "type": "symbol", "source": "omt", "source-layer": "place", "minzoom": 7, "filter": ["in", "class", "town"],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 7, 9, 11, 13], "text-max-width": 8 },
      "paint": { "text-color": "#8e9db8", "text-halo-color": "#121a2a", "text-halo-width": 1.2 } },
    { "id": "place-capital", "type": "symbol", "source": "omt", "source-layer": "place", "minzoom": 3, "filter": ["all", ["==", "class", "city"], ["==", "capital", 2]],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": ["interpolate", ["linear"], ["zoom"], 3, 10, 6, 13, 10, 18], "text-transform": "uppercase", "text-letter-spacing": 0.12, "text-anchor": "top", "text-offset": [0, 0.3], "text-max-width": 8 },
      "paint": { "text-color": "#e6ecf7", "text-halo-color": "#121a2a", "text-halo-width": 1.6 } },
    { "id": "place-country", "type": "symbol", "source": "omt", "source-layer": "place", "maxzoom": 7, "filter": ["==", "class", "country"],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 5, 16], "text-transform": "uppercase", "text-letter-spacing": 0.35, "text-max-width": 7 },
      "paint": { "text-color": "#6d7f9e", "text-halo-color": "#121a2a", "text-halo-width": 1.5 } }
  ]
}
